# .env.example: copy to .env (never commit .env).
# The checker works with NO key. Keys only enable the plain-English AI explanation.
# The verdict is always computed by static analysis, never by the LLM.

# Pick one (first one set wins, in this order: Anthropic, OpenRouter, OpenAI).
# To force one regardless of other keys in your shell: SCAMCHECK_PROVIDER=openrouter
# Test your setup:  python3 -m scamcheck --check-llm
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional model override (defaults: claude-haiku-4-5 / anthropic/claude-haiku-4.5 / gpt-4o-mini)
# SCAMCHECK_MODEL=

# Web server
# SCAMCHECK_HOST=127.0.0.1
# SCAMCHECK_PORT=8765
# SCAMCHECK_RATE_LIMIT=20   # requests per IP per minute
